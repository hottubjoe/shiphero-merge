# ============================================================
# COLDEST Order Merge Engine — settings
# Copy this file to ".env" and fill in the values.
# NEVER share your .env file. It contains passwords and keys.
# ============================================================

# ---------- SAFETY SWITCHES (leave these alone for now) ----------
# true = never change anything in TikTok or ShipHero (only reads + simulations)
DRY_RUN=true
# true = every change needs your click in the dashboard, max 2 orders per group,
#        and only orders listed in PILOT_ORDER_IDS are allowed
PILOT_MODE=true
# Comma-separated TikTok order IDs allowed during the pilot (exactly the 2 you pick)
PILOT_ORDER_IDS=
# How tracking reaches TikTok:
#   native_verify = ShipHero's built-in TikTok integration sends tracking; this app only CHECKS it (safe default)
#   engine        = this app sends tracking to TikTok itself (only after native duplicate updates are ruled out)
TRACKING_MODE=native_verify
# Carriers that always need manual review (TikTok requires USPS labels to come from TikTok Shipping)
BLOCKED_CARRIERS=USPS

# ---------- DASHBOARD ----------
DASHBOARD_PORT=4870
# Pick a long password (12+ characters on your PC, 16+ in the cloud). You type this to open the dashboard.
DASHBOARD_PASSWORD=
# Optional: secret used to sign the login cookie. Leave empty and the app creates and stores one itself.
SESSION_SECRET=

# ---------- TIKTOK SHOP (from partner.tiktokshop.com > App & Service > your app) ----------
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Optional: shows the seller authorization link (https://services.tiktokshops.us/open/authorize?service_id=...) in the dashboard
TIKTOK_SERVICE_ID=
# Filled in for you by "npm run tiktok:auth" (you can also paste them here)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Filled in by "npm run verify-api" (it lists your authorized shops)
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_ID=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# ---------- SHIPHERO (app.shiphero.com/dashboard/users > + Add Third-Party Developer > Refresh Token) ----------
SHIPHERO_REFRESH_TOKEN=
SHIPHERO_ACCESS_TOKEN=
SHIPHERO_API_BASE=https://public-api.shiphero.com
# Shared secret used to check that webhooks really come from ShipHero
SHIPHERO_WEBHOOK_SECRET=
# How ShipHero stores the TikTok order ID. "partner_order_id" is what we expect from
# the native integration — confirm with "npm run verify-api" before going live.
SHIPHERO_TIKTOK_ID_FIELD=partner_order_id

# ---------- AUTOMATION ----------
# Minutes to wait for more orders from the same customer before combining
CONSOLIDATION_WINDOW_MINUTES=5
# Never hold an order closer than this many hours to its TikTok ship-by deadline
DEADLINE_SAFETY_HOURS=12
# Seconds between background checks
POLL_INTERVAL_SECONDS=60
# Optional: average cost of one single-order label, to estimate savings (e.g. 4.85)
AVG_SINGLE_LABEL_COST=

# ---------- STORAGE ----------
DATABASE_FILE=./data/coldest-merge.sqlite
LOG_FILE=./data/engine.log
